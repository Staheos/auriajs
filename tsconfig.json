{
  "compilerOptions": {
    "declaration": true,
    "outDir": "./dist",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "lib": ["ES2020", "DOM"],
    "sourceMap": true,
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node", "jest"],
    "isolatedModules": true
  },
  "include": ["src", "global.d.ts"],
}
